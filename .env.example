# Settings this site's code reads -- NAMES ONLY. Never put a real value in this file
# or in any committed file. Real values live in Netlify (Site configuration ->
# Environment variables) or, for the scheduled job, in GitHub (repository secrets
# and variables). For a local run, copy this to .env (git ignores it).
#
# Generated 2026-10-13 from the names the code actually reads: netlify/functions,
# build/build.py, build/tools and scripts/netlify-build.sh. Unset means the code's
# default, which for every switch is OFF. docs/SIGNATURE-MOVE.md and
# docs/HUB-TOWN-STATS.md say which of these this site should and should not set.

# ---- Website leads (netlify/functions/submission-created.js, lofty-queue-drain.js) ----
# Lofty API key: every website lead goes into Lofty with it; also /status and the listing refresh.
LOFTY_API_KEY=
# "off" pauses the failed-lead retry queue without removing the Lofty key; unset = drains as normal.
LOFTY_QUEUE_DRAIN=
# The instant lead-alert email to Christine goes through the Seller Intelligence hub (lib/_notify.js).
# This site's hub key for the lead alert, sent as x-hub-key with HUB_API_URL below (unset = no alert email).
HUB_API_KEY=
# Build E (lib/_hub-intake.js): exactly "on" sends the value forms (free-home-valuation, sellers-page-inquiry, the homepage "value" choice) to the hub, which drafts a value review for Christine. Unset = off.
WEBSITE_TO_HUB_INTAKE=
# The hub key for that, sent as x-hub-key to HUB_API_URL: it can only write intake (not the HUB_API_KEY above).
HUB_INTAKE_KEY=
# Build E (lib/_form-plans.js): exactly "on" makes free-home-valuation and the homepage "value" choice wait for the Lofty tag "Value Review Sent" (the HV plan) instead of starting S2. Unset = off.
VALUE_REVIEW_PLAN=
# Build E (lib/_home-updates.js): exactly "on" opens the "What have you updated?" form a value review links to; answers go to the hub with HUB_INTAKE_KEY (needs hub scope valuereview:updates). Unset = off.
VALUE_REVIEW_UPDATES_FORM=
# Read only so /status can say it is a leftover: nothing on this site sends with it. Leave unset.
RESEND_API_KEY=
# Who gets the lead alert (comma-separated); unset = Christine's own inbox. Must be on the hub's email_internal_recipients.
LEAD_ALERT_TO=
# Sender for the lead alert, only one the hub allows (its email_from or email_from_allowed); unset = the hub's own sender.
LEAD_ALERT_FROM=
# Flodesk API key: newsletter sign-ups are added to Flodesk (unset = that step is skipped).
FLODESK_API_KEY=
# Flodesk segment id for Larimer County newsletter sign-ups.
FLODESK_SEGMENT_LARIMER=
# Flodesk segment id for Weld County newsletter sign-ups.
FLODESK_SEGMENT_WELD=
# Flodesk segment id for Boulder County newsletter sign-ups.
FLODESK_SEGMENT_BOULDER=
# Flodesk fallback segment id (other area, no answer, or a county whose own id is unset).
FLODESK_SEGMENT_NEWSLETTER=

# ---- Listings and maps (functions moved from Signature; lib/_backend-mode.js) ----
# Which moved functions answer here: unset or "proxy" = pass through to Signature; "local" or a comma list of function names.
BACKEND_MODE=
# Netlify Blobs site id of the store holding her listing copy (the Signature project's).
BLOBS_SITE_ID=
# Netlify personal access token for that Blobs store.
BLOBS_TOKEN=
# "on" shows stored listings; anything else (or unset) keeps listing display off.
IDX_DISPLAY=
# Where searches go instead (her Lofty site's /listing page); unset = the address in lib/_idx-display.js.
IDX_SEARCH_URL=
# Comma-separated counties a search naming no town covers; unset = Larimer and Weld.
HOME_SEARCH_COUNTIES=
# MLS numbers never to show (comma- or space-separated, with or without the IRE prefix).
HIDE_LISTING_IDS=
# "lofty" (default) or "mlsgrid": where listings come from.
LISTINGS_SOURCE=
# Surname that marks her own listings; unset = gwinnup.
LISTING_AGENT_SURNAME=
# Comma-separated counties to keep when storing listings; unset = no filter.
OPERATING_COUNTIES=
# Google Maps key (Geocoding, Places, Distance Matrix): walkability, nearby places, local spots, sold map, build/tools/geocode_towns.py.
GOOGLE_MAPS_API_KEY=
# Public Mapbox token (must start "pk.") for the explore map.
MAPBOX_PUBLIC_TOKEN=
# Key for Listing Engine's recent-activity feed (unset = the strip stays empty).
LISTING_FEED_KEY=
# Listing Engine API address for that feed; unset = the default in recent-activity.js.
LISTING_ENGINE_URL=
# "on" shows the recent-activity strip while listings come from Lofty; unset = hidden.
RECENT_ACTIVITY_DISPLAY=

# ---- MLS Grid (read by copied code and /status; this site does not call MLS Grid) ----
# MLS Grid token. Do NOT set on this site (docs/SIGNATURE-MOVE.md); read only to report it absent.
MLSGRID_API_TOKEN=
# "off" switches MLS Grid market data off (recommended here).
MLSGRID_MARKET_DATA=
# "true" (or 1/yes/on) is the MLS Grid kill switch (recommended here).
MLS_DISABLED=
# MLS Grid quota guard: share of each ceiling to stop at; unset = 0.5 (kept between 0.05 and 0.95). Do not set here.
MLS_QUOTA_SAFETY_FRACTION=
# MLS Grid hourly request ceiling; may only lower the published limit. Do not set here.
MLS_QUOTA_HOURLY_REQUESTS=
# MLS Grid hourly download ceiling in MB; may only lower the published limit. Do not set here.
MLS_QUOTA_HOURLY_MB=
# MLS Grid daily request ceiling; may only lower the published limit. Do not set here.
MLS_QUOTA_DAILY_REQUESTS=
# MLS Grid daily download ceiling in MB; may only lower the published limit. Do not set here.
MLS_QUOTA_DAILY_MB=
# Cloudinary as one cloudinary:// URL (or the three parts below); /status reports it only, nothing here uploads photos. Leave unset.
CLOUDINARY_URL=
# Cloudinary cloud name (the three-part form of CLOUDINARY_URL). Leave unset.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key (the three-part form). Leave unset.
CLOUDINARY_API_KEY=
# Cloudinary API secret (the three-part form). Leave unset.
CLOUDINARY_API_SECRET=

# ---- Build (build/build.py, Netlify build environment) ----
# GA4 measurement id; the Google Analytics tag is added only when set.
GA_MEASUREMENT_ID=
# Meta Pixel id; the pixel is added only when set.
META_PIXEL_ID=
# Google Search Console verification token for the meta tag; unset = no tag.
GSC_VERIFICATION=
# Booking link for the schedule button; unset = the link in build.py's SITE settings.
CALENDLY_URL=
# Exactly "on" adds the RealScout Home Value Alert sign-up link after the form on /free-home-valuation.html. Unset = off.
HVA_SIGNUP_LINK=
# That sign-up address (https on realscout.com only, else the link is left out); unset = the address in build.py.
REALSCOUT_HVA_SIGNUP_URL=
# Exactly "on" adds the RealScout "Search <Town> Homes With Christine" button to the Northern Colorado town pages. Unset = off.
TOWN_SEARCH_LINK=
# That button's address (https on realscout.com only, else the button is left out); unset = the address in build.py.
REALSCOUT_SEARCH_URL=
# Exactly "on" adds the "Selling it yourself?" form (fsbo-inquiry) to the FSBO guide page at build time; unset = off. docs/FSBO-FORM.md.
FSBO_FORM=

# ---- Town figures (build/tools/town-market-stats.js, town-market-compare.js; docs/HUB-TOWN-STATS.md) ----
# "hub" takes the town figures from the hub at build time (also a GitHub repository variable for the workflow); unset = Signature's file.
TOWN_STATS_SOURCE=
# The hub's base address: the lead alert and, with TOWN_STATS_SOURCE=hub, the town figures (also a GitHub repository variable for the workflow).
HUB_API_URL=
# This site's read-only hub key, sent as x-hub-key (also a GitHub repository SECRET for the workflow); unset = HUB_API_KEY is used (needs scope market:read).
HUB_APP_KEY=
# Exactly "hub": the MLS check a refresh started here runs asks the Seller Intelligence hub (HUB_API_URL + HUB_API_KEY, scope mls:read), never MLS Grid; unset = as before (docs/mls-via-hub.md).
MLS_SOURCE=
# Testing only: another address for Signature's published town file.
TOWN_MARKET_URL=

# ---- scripts/netlify-build.sh overrides (testing only; leave unset) ----
# Python to build with; unset = python3.
PYTHON_BIN=
# The generator; unset = build/build.py.
BUILD_SCRIPT=
# The technical/SEO postprocessor; unset = build/postprocess_audit_fixes_v2.py.
POSTPROCESS_SCRIPT=
# The ROI postprocessor; unset = build/postprocess_roi_conversion_v2.py.
ROI_POSTPROCESS_SCRIPT=
# The traffic-growth postprocessor; unset = build/postprocess_traffic_growth_v2.py.
TRAFFIC_POSTPROCESS_SCRIPT=
# The pip requirements file; unset = requirements.txt.
REQS_FILE=

# ---- Lofty through the Seller Intelligence hub (Wave 1b, lib/_lofty-hub.js; docs/LOFTY-VIA-HUB.md) ----
# Exactly "on" sends form leads and the queue replay to the hub's Lofty doorway (HUB_API_URL + HUB_API_KEY); unset = this site's own LOFTY_API_KEY.
LOFTY_VIA_HUB=
# Exactly "on" also records each form lead with the hub's lead router (never the rent-to-own form); unset = off.
LEADS_TO_ROUTER=

# ---- The side-by-side check with the hub (lib/_hub-side-by-side.js; docs/hub-side-by-side.md) ----
# Comma-separated areas to also ask the hub about and compare, next to this site's own work (lofty_write, mls_read); unset = off.
HUB_SIDE_BY_SIDE=
# Comparisons per run (the scheduled sync and the town-figures job) or per hour (the form handler); unset = 20, at most 200.
HUB_SIDE_BY_SIDE_MAX=

# ---- Shared toolkit Google sign-in (netlify/functions/lib/suite-kit/google-signin.js) ----
# The vendored toolkit (0.5.2) carries the suite-wide Google sign-in. This site has no sign-in and never calls it: leave unset.
GOOGLE_SIGNIN=
# Toolkit Google sign-in only (see above): "on" would allow Google sign-in alone. Not used by this site; leave unset.
GOOGLE_SIGNIN_ONLY=
# Toolkit Google sign-in only: the Google OAuth client id. Not used by this site; leave unset.
GOOGLE_CLIENT_ID=
# Toolkit Google sign-in only: the Google OAuth client secret. Not used by this site; leave unset.
GOOGLE_CLIENT_SECRET=
# Toolkit Google sign-in only: the key that signs a sign-in session. Not used by this site; leave unset.
SESSION_SECRET=
# Toolkit Google sign-in only: the public address Google sends a sign-in back to. Not used by this site; leave unset.
PUBLIC_BASE_URL=
